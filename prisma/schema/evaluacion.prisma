// Módulo evaluación: cierres, notas por competencia, resultados consolidados, evidencias y rectificaciones.
// Generado a partir del diagrama de clases v4.2. Tablas y columnas en snake_case.

model CierreCalificacion {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asignacionDocenteId    String                 @db.Uuid @map("asignacion_docente_id")
  asignacionDocente      AsignacionDocente      @relation(fields: [asignacionDocenteId], references: [id], onDelete: Restrict)
  periodoEvaluacionId    String                 @db.Uuid @map("periodo_evaluacion_id")
  periodoEvaluacion      PeriodoEvaluacion      @relation(fields: [periodoEvaluacionId], references: [id], onDelete: Restrict)
  reglaConsolidacionId   String                 @db.Uuid @map("regla_consolidacion_id")
  reglaConsolidacion     ReglaConsolidacion     @relation(fields: [reglaConsolidacionId], references: [id], onDelete: Restrict)
  estado                 EstadoCierre           @default(PENDIENTE_APERTURA)
  cerradoPorId           String?                @db.Uuid @map("cerrado_por_id")
  cerradoPor             Usuario?               @relation("CierreCalificacionCerradoPor", fields: [cerradoPorId], references: [id], onDelete: SetNull)
  cerradoEn              DateTime?              @db.Timestamptz(3) @map("cerrado_en")
  publicadoPorId         String?                @db.Uuid @map("publicado_por_id")
  publicadoPor           Usuario?               @relation("CierreCalificacionPublicadoPor", fields: [publicadoPorId], references: [id], onDelete: SetNull)
  publicadoEn            DateTime?              @db.Timestamptz(3) @map("publicado_en")
  createdAt              DateTime               @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt              DateTime               @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")
  notas                  Nota[]
  resultadosConsolidados ResultadoConsolidado[]

  @@unique([asignacionDocenteId, periodoEvaluacionId])
  @@map("cierre_calificacion")
}

model Nota {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cierreId                 String                   @db.Uuid @map("cierre_id")
  cierre                   CierreCalificacion       @relation(fields: [cierreId], references: [id], onDelete: Cascade)
  matriculaId              String                   @db.Uuid @map("matricula_id")
  matricula                Matricula                @relation(fields: [matriculaId], references: [id], onDelete: Restrict)
  competenciaPlanId        String                   @db.Uuid @map("competencia_plan_id")
  competenciaPlan          CompetenciaPlan          @relation(fields: [competenciaPlanId], references: [id], onDelete: Restrict)
  logro                    Logro
  registradoPorId          String                   @db.Uuid @map("registrado_por_id")
  registradoPor            Usuario                  @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)
  createdAt                DateTime                 @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt                DateTime                 @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")
  evidenciasPedagogicas    EvidenciaPedagogica[]
  solicitudesRectificacion SolicitudRectificacion[]

  @@unique([cierreId, matriculaId, competenciaPlanId])
  @@index([matriculaId])
  @@map("nota")
}

model ResultadoConsolidado {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cierreId         String             @db.Uuid @map("cierre_id")
  cierre           CierreCalificacion @relation(fields: [cierreId], references: [id], onDelete: Cascade)
  matriculaId      String             @db.Uuid @map("matricula_id")
  matricula        Matricula          @relation(fields: [matriculaId], references: [id], onDelete: Restrict)
  logroConsolidado Logro?             @map("logro_consolidado")
  incompleto       Boolean            @default(false)
  detalleCalculo   Json               @map("detalle_calculo")
  calculadoEn      DateTime           @default(now()) @db.Timestamptz(3) @map("calculado_en")
  createdAt        DateTime           @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  @@unique([cierreId, matriculaId])
  @@map("resultado_consolidado")
}

model EvidenciaPedagogica {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notaId           String          @db.Uuid @map("nota_id")
  nota             Nota            @relation(fields: [notaId], references: [id], onDelete: Cascade)
  entregaTrabajoId String?         @db.Uuid @map("entrega_trabajo_id")
  entregaTrabajo   EntregaTrabajo? @relation(fields: [entregaTrabajoId], references: [id], onDelete: SetNull)
  titulo           String?
  comentario       String?
  archivoUrl       String?         @map("archivo_url")
  nombreArchivo    String?         @map("nombre_archivo")
  mimeType         String?         @map("mime_type")
  tamanoBytes      Int?            @map("tamano_bytes")
  subidoPorId      String          @db.Uuid @map("subido_por_id")
  subidoPor        Usuario         @relation(fields: [subidoPorId], references: [id], onDelete: Restrict)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt        DateTime        @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  @@map("evidencia_pedagogica")
}

model SolicitudRectificacion {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notaId          String          @db.Uuid @map("nota_id")
  nota            Nota            @relation(fields: [notaId], references: [id], onDelete: Restrict)
  valorAnterior   Logro           @map("valor_anterior")
  valorSolicitado Logro           @map("valor_solicitado")
  motivo          String
  estado          EstadoSolicitud @default(PENDIENTE)
  motivoRechazo   String?         @map("motivo_rechazo")
  resueltoPorId   String?         @db.Uuid @map("resuelto_por_id")
  resueltoPor     Usuario?        @relation(fields: [resueltoPorId], references: [id], onDelete: SetNull)
  resueltoEn      DateTime?       @db.Timestamptz(3) @map("resuelto_en")
  createdAt       DateTime        @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  @@map("solicitud_rectificacion")
}
