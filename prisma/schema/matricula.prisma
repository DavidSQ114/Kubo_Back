// Módulo matrícula: matrículas, historial de secciones, cobros, operaciones de pago, pagos, comprobantes e intentos
// de pago en línea (US70).
// Generado a partir del diagrama de clases v4.2. Tablas y columnas en snake_case.

model Matricula {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  estudianteId           String                 @db.Uuid @map("estudiante_id")
  estudiante             Estudiante             @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  seccionId              String?                @db.Uuid @map("seccion_id")
  seccion                Seccion?               @relation(fields: [seccionId], references: [id], onDelete: SetNull)
  anioAcademicoId        String                 @db.Uuid @map("anio_academico_id")
  anioAcademico          AnioAcademico          @relation(fields: [anioAcademicoId], references: [id], onDelete: Restrict)
  vinculoResponsableId   String?                @db.Uuid @map("vinculo_responsable_id")
  vinculoResponsable     VinculoApoderado?      @relation(fields: [vinculoResponsableId], references: [id], onDelete: SetNull)
  fechaMatricula         DateTime               @default(now()) @db.Date @map("fecha_matricula")
  estado                 EstadoMatricula        @default(EN_PROCESO)
  modalidadPago          ModalidadPago          @default(MENSUAL) @map("modalidad_pago")
  registradoPorId        String                 @db.Uuid @map("registrado_por_id")
  registradoPor          Usuario                @relation("MatriculaRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict)
  retiradoEn             DateTime?              @db.Timestamptz(3) @map("retirado_en")
  motivoRetiro           MotivoRetiro?          @map("motivo_retiro")
  detalleRetiro          String?                @map("detalle_retiro")
  anuladoPorId           String?                @db.Uuid @map("anulado_por_id")
  anuladoPor             Usuario?               @relation("MatriculaAnuladoPor", fields: [anuladoPorId], references: [id], onDelete: SetNull)
  anuladoEn              DateTime?              @db.Timestamptz(3) @map("anulado_en")
  motivoAnulacion        String?                @map("motivo_anulacion")
  ultimoRecordatorioEn   DateTime?              @db.Timestamptz(3) @map("ultimo_recordatorio_en")
  createdAt              DateTime               @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt              DateTime               @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")
  historialesSeccion     HistorialSeccion[]
  conceptosCobro         ConceptoCobro[]
  asistenciasEstudiante  AsistenciaEstudiante[]
  notas                  Nota[]
  resultadosConsolidados ResultadoConsolidado[]
  entregasTrabajo        EntregaTrabajo[]
  intentosPago           IntentoPago[]

  @@index([seccionId, estado])
  @@map("matricula")
}

model HistorialSeccion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matriculaId     String    @db.Uuid @map("matricula_id")
  matricula       Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  seccionId       String    @db.Uuid @map("seccion_id")
  seccion         Seccion   @relation(fields: [seccionId], references: [id], onDelete: Restrict)
  fechaInicio     DateTime  @db.Date @map("fecha_inicio")
  fechaFin        DateTime? @db.Date @map("fecha_fin")
  motivo          String?
  registradoPorId String    @db.Uuid @map("registrado_por_id")
  registradoPor   Usuario   @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  @@map("historial_seccion")
}

model ConceptoCobro {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matriculaId      String       @db.Uuid @map("matricula_id")
  matricula        Matricula    @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  tipo             TipoConcepto
  mes              Int?
  concepto         String
  monto            Decimal      @db.Decimal(10, 2)
  moneda           String       @default("PEN")
  fechaVencimiento DateTime     @db.Date @map("fecha_vencimiento")
  estado           EstadoCobro  @default(PENDIENTE)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")
  pagos            Pago[]

  @@unique([matriculaId, tipo, mes])
  @@index([estado, fechaVencimiento])
  @@map("concepto_cobro")
}

model OperacionPago {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numeroOperacion      String           @map("numero_operacion")
  medioPago            MedioPago        @map("medio_pago")
  /// TESORERIA: registro manual (US22). PASARELA: pago en línea confirmado por el webhook o la conciliación (US70).
  origen               OrigenPago       @default(TESORERIA)
  /// ID de la order en la pasarela; único para que un aviso repetido no registre dos veces el pago (US70).
  referenciaExterna    String?          @unique(map: "uq_operacion_pago_referencia_externa") @map("referencia_externa")
  fechaPago            DateTime         @db.Timestamptz(3) @map("fecha_pago")
  montoTotal           Decimal          @db.Decimal(10, 2) @map("monto_total")
  estado               EstadoPago
  /// Por qué quedó Observado un pago en línea (por ejemplo, «Cuota pagada por otro medio»).
  motivoObservacion    String?          @map("motivo_observacion")
  /// Vacío solo si el origen es PASARELA: la registra el Sistema (ck_operacion_pago_registrador).
  registradoPorId      String?          @db.Uuid @map("registrado_por_id")
  registradoPor        Usuario?         @relation("OperacionPagoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict)
  confirmadoPorId      String?          @db.Uuid @map("confirmado_por_id")
  confirmadoPor        Usuario?         @relation("OperacionPagoConfirmadoPor", fields: [confirmadoPorId], references: [id], onDelete: SetNull)
  anuladoPorId         String?          @db.Uuid @map("anulado_por_id")
  anuladoPor           Usuario?         @relation("OperacionPagoAnuladoPor", fields: [anuladoPorId], references: [id], onDelete: SetNull)
  anuladoEn            DateTime?        @db.Timestamptz(3) @map("anulado_en")
  motivoAnulacion      MotivoAnulacion? @map("motivo_anulacion")
  observacionAnulacion String?          @map("observacion_anulacion")
  createdAt            DateTime         @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt            DateTime         @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")
  pagos                Pago[]
  comprobante          Comprobante?
  intentoPago          IntentoPago?

  @@index([numeroOperacion])
  @@index([origen, estado])
  @@map("operacion_pago")
}

/// Intento de pago en línea desde el portal del apoderado (US70). No reserva las cuotas: se validan al confirmar.
model IntentoPago {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matriculaId       String            @db.Uuid @map("matricula_id")
  matricula         Matricula         @relation(fields: [matriculaId], references: [id], onDelete: Restrict)
  creadoPorId       String            @db.Uuid @map("creado_por_id")
  creadoPor         Usuario           @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  /// Cuotas (concepto_cobro) que el apoderado eligió pagar.
  conceptoIds       String[]          @db.Uuid @map("concepto_ids")
  monto             Decimal           @db.Decimal(10, 2)
  moneda            String            @default("PEN")
  estado            EstadoIntentoPago @default(PENDIENTE)
  /// external_reference enviado a la pasarela.
  referenciaExterna String            @unique(map: "uq_intento_pago_referencia_externa") @map("referencia_externa")
  pasarela          String
  /// ID de la order creada en la pasarela.
  ordenExternaId    String?           @unique(map: "uq_intento_pago_orden_externa") @map("orden_externa_id")
  urlCheckout       String?           @map("url_checkout")
  /// status/status_detail de la pasarela en la última consulta (sin datos de tarjeta).
  estadoExterno     String?           @map("estado_externo")
  detalle           String?
  expiraEn          DateTime          @db.Timestamptz(3) @map("expira_en")
  conciliadoEn      DateTime?         @db.Timestamptz(3) @map("conciliado_en")
  operacionPagoId   String?           @unique @db.Uuid @map("operacion_pago_id")
  operacionPago     OperacionPago?    @relation(fields: [operacionPagoId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt         DateTime          @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  @@index([estado, createdAt])
  @@map("intento_pago")
}

model Pago {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operacionPagoId String        @db.Uuid @map("operacion_pago_id")
  operacionPago   OperacionPago @relation(fields: [operacionPagoId], references: [id], onDelete: Cascade)
  conceptoCobroId String        @db.Uuid @map("concepto_cobro_id")
  conceptoCobro   ConceptoCobro @relation(fields: [conceptoCobroId], references: [id], onDelete: Restrict)
  montoAplicado   Decimal       @db.Decimal(10, 2) @map("monto_aplicado")
  createdAt       DateTime      @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  @@unique([operacionPagoId, conceptoCobroId])
  @@map("pago")
}

model Comprobante {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operacionPagoId   String        @unique @db.Uuid @map("operacion_pago_id")
  operacionPago     OperacionPago @relation(fields: [operacionPagoId], references: [id], onDelete: Restrict)
  numeroComprobante String        @unique @map("numero_comprobante")
  nombreArchivo     String        @map("nombre_archivo")
  archivoUrl        String        @map("archivo_url")
  mimeType          String        @map("mime_type")
  tamanoBytes       Int?          @map("tamano_bytes")
  checksumSha256    String?       @map("checksum_sha256")
  montoTotal        Decimal       @db.Decimal(10, 2) @map("monto_total")
  enviadoEn         DateTime?     @db.Timestamptz(3) @map("enviado_en")
  createdAt         DateTime      @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt         DateTime      @default(now()) @updatedAt @db.Timestamptz(3) @map("updated_at")

  @@map("comprobante")
}
