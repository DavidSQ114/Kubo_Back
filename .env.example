# Copiar como .env (nunca subir .env a git)

# Base de datos (Docker local, puerto 5433). La sesión va en UTC (options=-c TimeZone=UTC).
DATABASE_URL="postgresql://kubo:kubo@localhost:5433/kubo_dev?schema=public&options=-c%20TimeZone%3DUTC"

# Firma de los JWT: mínimo 32 caracteres aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# URL pública de la aplicación (enlaces de los correos)
APP_URL="http://localhost:3000"

# Carpeta del log con rotación de 50 MB (vacío = solo consola)
LOG_DIR="logs"

# Correo SMTP (vacío en desarrollo: los correos se muestran en la consola)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Kubo <no-responder@kubo.edu.pe>"

# Pago en línea (US70). Vacío: el botón «Pagar» no aparece. En desarrollo usa la pasarela falsa:
#   PASARELA="falsa" y MP_WEBHOOK_SECRET con 16 caracteres o más (firma de los avisos de prueba).
# Con Mercado Pago (sandbox): PASARELA="mercadopago", el access token de la cuenta de prueba y la clave secreta del
# webhook (Tus integraciones → Webhooks). Nunca subas valores reales.
PASARELA=""
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
