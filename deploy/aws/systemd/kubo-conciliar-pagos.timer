# US71, US55 y US32 · Ejecuta kubo-conciliar-pagos.service cada 15 minutos (y al arrancar, si se perdió una
# ejecución): conciliación de pagos en línea, reintento de los correos de la bandeja de salida y faltas de docentes.
# Lo instala y activa deploy/aws/instalar.sh; en un servidor ya instalado, ver docs/DESPLIEGUE-AWS.md.
[Unit]
Description=Kubo · conciliar pagos en línea cada 15 minutos

[Timer]
OnCalendar=*:0/15
Persistent=true
RandomizedDelaySec=60
Unit=kubo-conciliar-pagos.service

[Install]
WantedBy=timers.target
