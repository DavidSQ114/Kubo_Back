# Tareas de cada 15 minutos: npm run conciliar-pagos desde la versión desplegada, como kubo y con las variables de
# /etc/kubo/kubo.env (scripts/tareasProgramadas.ts). Concilia los pagos en línea (US71), reintenta los correos
# pendientes de la bandeja de salida (US55) y marca las faltas de los docentes sin marcar a la hora límite (US32).
# Lo dispara kubo-conciliar-pagos.timer; a mano:
#   sudo systemctl start kubo-conciliar-pagos.service  y  journalctl -u kubo-conciliar-pagos.service
# Sin PASARELA en kubo.env la conciliación no hace nada; los correos se reintentan igual.
[Unit]
Description=Kubo · conciliar pagos en línea pendientes
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/kubo/current/package.json

[Service]
Type=oneshot
User=kubo
Group=kubo
WorkingDirectory=/opt/kubo/current
EnvironmentFile=/etc/kubo/kubo.env
ExecStart=/usr/bin/npm run --silent conciliar-pagos
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
